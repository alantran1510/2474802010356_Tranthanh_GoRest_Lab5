        {
          "name": "Request 1",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const email = pm.iterationData.get(\"email\") || \"student@example.com\";\r",
                  "const p = email.split(\"@\");\r",
                  "pm.environment.set(\"runEmail\", p[0] + \".\" + Date.now() + \"@\" + p[1]);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));\r",
                  "const j = pm.response.json();\r",
                  "pm.environment.set(\"userId\", j.id);\r",
                  "pm.environment.set(\"createdEmail\", j.email);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{name}}\",\r\n\"gender\":\"{{gender}}\",\r\n\"email\":\"{{runEmail}}\",\r\n\"status\":\"{{status}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
